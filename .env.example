# ============================================
# FLUMBERICO - ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL Connection (Production - use connection pooling)
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&connection_limit=20"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ============================================
# AI API KEYS
# ============================================
# Google Gemini API (Required for AI features)
GOOGLE_AI_API_KEY="your-google-ai-api-key-here"

# OpenAI API (Optional backup)
OPENAI_API_KEY="your-openai-api-key-here"

# ============================================
# AUTHENTICATION (NextAuth.js)
# ============================================
# Generate a secure random string (min 32 characters)
# Use: openssl rand -base64 32
NEXTAUTH_SECRET="GENERATE-A-SECURE-RANDOM-STRING-HERE-MIN-32-CHARS"

# Your production URL
NEXTAUTH_URL="https://your-domain.com"

# ============================================
# ADMIN CREDENTIALS
# ============================================
# IMPORTANT: Change these immediately in production!
ADMIN_EMAIL="your-admin-email@domain.com"
ADMIN_PASSWORD="CHANGE-THIS-TO-A-STRONG-PASSWORD"

# ============================================
# STRIPE PAYMENT CONFIGURATION
# ============================================
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_your-stripe-secret-key"
STRIPE_PUBLISHABLE_KEY="pk_live_your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"

# Stripe Price IDs (from your Stripe products)
STRIPE_PRO_PRICE_ID="price_your-monthly-price-id"
STRIPE_PRO_ANNUAL_PRICE_ID="price_your-annual-price-id"

# ============================================
# CRON JOB SECURITY
# ============================================
# Generate a strong secret for cron endpoints
# Use: openssl rand -hex 32
CRON_SECRET="GENERATE-A-SECURE-RANDOM-HEX-STRING-HERE"

# ============================================
# REDIS CONFIGURATION (Optional - for BullMQ)
# ============================================
REDIS_HOST="your-redis-host"
REDIS_PORT="6379"
REDIS_PASSWORD="your-redis-password"

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV="production"
PORT=3000
NEXT_PUBLIC_SITE_NAME="Flumberico"
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# File Upload Limits
MAX_FILE_SIZE=10485760  # 10MB in bytes

# ============================================
# OPTIONAL: EMAIL SERVICE (Future)
# ============================================
# SMTP_HOST="smtp.your-provider.com"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-username"
# SMTP_PASSWORD="your-smtp-password"
# SMTP_FROM="noreply@your-domain.com"