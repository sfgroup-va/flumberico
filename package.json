{
  "name": "nextjs-job-board",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:docker": "npm run docker:up && npm run wait-for-db && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "node scripts/seed.js",
    "seed:docker": "npm run wait-for-db && node scripts/seed.js",
    "postinstall": "prisma generate",
    "workers": "tsx src/workers/index.ts",
    "workers:dev": "tsx watch src/workers/index.ts",
    "queue:stats": "tsx -e \"import { QueueManager } from './src/lib/queue'; QueueManager.getQueueStats().then(console.log)\"",
    "docker:up": "sudo docker compose up -d postgres redis",
    "docker:down": "sudo docker compose down",
    "docker:tools": "sudo docker compose --profile tools up -d adminer",
    "docker:logs": "sudo docker compose logs -f postgres redis",
    "docker:reset": "sudo docker compose down -v && sudo docker compose up -d postgres redis",
    "wait-for-db": "node scripts/wait-for-db.js",
    "db:reset": "echo '⚠️  WARNING: This will delete all data! Create backup first with: npm run db:backup' && sleep 3 && prisma migrate reset --force",
    "db:reset:docker": "echo '⚠️  WARNING: This will delete all data! Create backup first with: npm run db:backup' && sleep 3 && npm run wait-for-db && prisma migrate reset --force",
    "db:backup": "node scripts/backup-restore.js backup",
    "db:restore": "node scripts/backup-restore.js restore",
    "db:migrate": "prisma migrate dev",
    "db:migrate:docker": "npm run wait-for-db && prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:studio:docker": "npm run docker:up && npm run wait-for-db && prisma studio",
    "sitemap": "node scripts/generate-all-sitemaps.js",
    "sitemap:jobs": "node scripts/generate-jobs-sitemap-simple.js",
    "sitemap:jobs:db": "node scripts/generate-jobs-sitemap.js"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.34.3",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^3.3.3",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@playwright/test": "^1.56.1",
    "@prisma/client": "^5.7.1",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@stripe/stripe-js": "^8.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/formidable": "^3.4.6",
    "@types/ioredis": "^4.28.10",
    "@vercel/blob": "^0.16.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.63.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.0.6",
    "draft-js": "^0.11.7",
    "formidable": "^3.5.4",
    "framer-motion": "^12.23.24",
    "googleapis": "^168.0.0",
    "immutable": "^5.1.4",
    "ioredis": "^5.8.2",
    "lucide-react": "^0.303.0",
    "markdown-draft-js": "^2.4.0",
    "nanoid": "^5.0.4",
    "next": "^16.0.1",
    "next-auth": "^4.24.5",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdf2json": "^4.0.0",
    "pdfreader": "^3.0.8",
    "playwright": "^1.56.1",
    "prisma": "^5.7.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-draft-wysiwyg": "^1.15.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.49.2",
    "react-markdown": "^9.0.1",
    "stripe": "^19.2.1",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/markdown-draft-js": "^2.2.7",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-draft-wysiwyg": "^1.13.7",
    "autoprefixer": "^10.0.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.1",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8",
    "prettier": "^3.1.1",
    "prettier-plugin-tailwindcss": "^0.5.10",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}